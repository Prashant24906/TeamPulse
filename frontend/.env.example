# ── Public Backend Endpoints ──────────────────────────────────────────────────
# These values are embedded into the client-side bundle at build time.
# NEVER put private secrets, database URLs, or API keys in this file.

# Public REST API base URL (including /api path)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# Public WebSocket URL for Socket.IO real-time connection
NEXT_PUBLIC_WS_URL=https://api.yourdomain.com

