# ── Server Configuration ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── Database (PostgreSQL / Neon / Supabase) ──────────────────────────────────
# Pooled connection string (required)
DATABASE_URL=postgresql://db_user:db_password@db_host:5432/db_name?sslmode=require

# Direct unpooled connection string (optional, for migrations or session pooling)
DATABASE_URL_UNPOOLED=postgresql://db_user:db_password@db_direct_host:5432/db_name?sslmode=require

# ── Authentication ────────────────────────────────────────────────────────────
# Cryptographically secure random secret — MUST be at least 32 characters long
# Example generation: openssl rand -base64 32
JWT_SECRET=replace_with_at_least_32_character_cryptographically_secure_random_string
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Exact origin of the production frontend application (no trailing slash)
CORS_ORIGIN=https://app.yourdomain.com

# ── Redis (Rate Limiting, Caching, BullMQ) ─────────────────────────────────────
# Standard redis:// or rediss:// (TLS) connection string
# Managed Redis (Redis Cloud, Upstash, ElastiCache) typically requires rediss://
REDIS_URL=rediss://default:redis_password@redis_host:6379

